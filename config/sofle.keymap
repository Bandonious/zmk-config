#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 1>;
            then-layer = <1>;
        };
    };

    behaviors {
        mt_HRM: mt_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            flavor = "tap-preferred";
        };

        CapWL: CapWL {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPWL";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        lt_bdx: lt_bdx {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BDX";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DEL>;
            key-positions = <53 56>;
        };
    };

    macros {
        undo_bd: undo_bd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
            label = "UNDO_BD";
        };

        redo_bd: redo_bd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RS(Z))>;
            label = "REDO_BD";
        };

        cut_bd: cut_bd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
            label = "CUT_BD";
        };

        copy_bd: copy_bd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "COPY_BD";
        };

        paste_bd: paste_bd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
            label = "PASTE_BD";
        };

        bullet: bullet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "BULLET";
        };

        mdash: mdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_2 &kp KP_N0 &kp KP_NUMBER_1 &kp KP_NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "MDASH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BRANDX";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&none             &kp N1              &kp N2              &kp N3                  &kp N4                &kp N5                                            &kp N6           &kp N7                 &kp N8                   &kp N9               &kp N0               &none
&kp ESCAPE        &kp Q               &kp W               &kp F                   &kp P                 &kp B                                             &kp J            &kp L                  &kp U                    &kp Y                &kp SEMICOLON        &none
&CapWL            &mt_HRM LEFT_WIN A  &mt_HRM LEFT_ALT R  &mt_HRM LEFT_CONTROL S  &mt_HRM LEFT_SHIFT T  &kp G                                             &kp M            &mt_HRM RIGHT_SHIFT N  &mt_HRM RIGHT_CONTROL E  &mt_HRM RIGHT_ALT I  &mt_HRM RIGHT_WIN O  &kp SQT
&lt 5 LG(PERIOD)  &kp Z               &kp X               &kp C                   &kp D                 &kp V            &kp LG(TAB)    &kp C_PLAY_PAUSE  &kp K            &kp H                  &kp COMMA                &kp DOT              &kp FSLH             &lt 5 EXCLAMATION
                                      &kp LGUI            &kp LALT                &lt_bdx 6 ESCAPE      &lt_bdx 1 SPACE  &lt 5 TAB      &lt 2 ENTER       &lt 3 BACKSPACE  &lt_bdx 4 DEL          &kp RALT                 &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp LS(TAB) TAB>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_NAV {
            display-name = "NAV";
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                        &trans         &trans          &trans          &trans        &trans           &trans
&trans  &trans        &trans        &trans            &trans          &trans                        &kp INS        &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                        &trans         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans        &trans        &trans            &trans          &trans  &trans    &trans      &redo_bd       &paste_bd       &copy_bd        &cut_bd       &undo_bd         &trans
                      &trans        &trans            &trans          &trans  &trans    &kp RETURN  &kp BACKSPACE  &kp DELETE      &trans          &trans
            >;
        };

        layer_SYS {
            display-name = "SYS";
            bindings = <
&trans          &trans           &trans      &trans       &trans         &trans                         &trans  &trans           &trans             &trans         &trans         &trans
&kp GRAVE       &kp CARET        &kp POUND   &bullet      &kp BACKSLASH  &kp PIPE                       &trans  &trans           &trans             &trans         &trans         &trans
&kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DOLLAR  &kp PERCENT  &kp AMPERSAND  &kp AT_SIGN                    &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
&trans          &trans           &trans      &mdash       &kp MINUS      &kp UNDER    &trans    &trans  &trans  &trans           &trans             &trans         &trans         &trans
                                 &trans      &trans       &trans         &trans       &trans    &trans  &trans  &trans           &trans             &trans
            >;
        };

        layer_NUM {
            display-name = "NUM";
            bindings = <
&trans                &trans                 &trans           &trans           &trans           &trans                                   &trans  &trans           &trans             &trans         &trans         &trans
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS                              &trans  &trans           &trans             &trans         &trans         &trans
&kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS                             &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
&trans                &kp KP_DOT             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY  &trans          &trans  &trans  &trans           &trans             &trans         &trans         &trans
                                             &trans           &trans           &kp KP_NUMBER_0  &kp KP_DIVIDE    &kp KP_EQUAL    &trans  &trans  &trans           &trans             &trans
            >;
        };

        layer_FUNC {
            display-name = "FUNC";
            bindings = <
&trans        &trans  &trans   &trans   &trans   &trans                             &trans  &trans           &trans             &trans         &trans         &trans
&kp C_BRI_UP  &kp F9  &kp F10  &kp F11  &kp F12  &kp PRINTSCREEN                    &trans  &trans           &trans             &trans         &trans         &trans
&kp C_BRI_DN  &kp F5  &kp F6   &kp F7   &kp F8   &kp LG(LS(S))                      &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
&trans        &trans  &kp F1   &kp F2   &kp F3   &trans           &trans    &trans  &trans  &trans           &trans             &trans         &trans         &trans
                      &trans   &trans   &trans   &trans           &trans    &trans  &trans  &trans           &trans             &trans
            >;
        };

        layer_ACT {
            display-name = "ACT";
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                               &trans      &trans           &trans             &trans         &trans         &trans
&trans  &trans        &trans        &trans            &trans          &trans                               &trans      &trans           &trans             &trans         &trans         &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LG(LS(S))                        &kp K_CALC  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
&trans  &undo_bd      &cut_bd       &copy_bd          &paste_bd       &redo_bd       &trans      &trans    &redo_bd    &paste_bd        &copy_bd           &cut_bd        &undo_bd       &trans
                      &trans        &trans            &mkp MB3        &mkp MB2       &mkp MB1    &mkp MB1  &mkp MB2    &mkp MCLK        &trans             &trans
            >;
        };

        layer_MEDIA {
            display-name = "MEDIA";
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                              &trans      &trans           &trans        &trans        &trans        &trans
&trans  &trans        &trans        &trans            &trans          &trans                              &bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                              &kp K_MUTE  &kp C_VOLUME_UP  &kp C_VOL_DN  &trans        &trans        &trans
&trans  &trans        &trans        &trans            &trans          &trans  &trans    &trans            &trans      &kp C_NEXT       &kp C_PREV    &trans        &trans        &trans
                      &trans        &trans            &trans          &trans  &trans    &kp C_PLAY_PAUSE  &trans      &trans           &trans        &trans
            >;
        };

        layer_7 {
            display-name = "MOUSE";
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                    &trans  &trans           &trans             &trans         &trans         &trans
&trans  &trans        &trans        &trans            &trans          &trans                    &trans  &trans           &trans             &trans         &trans         &trans
&trans  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                    &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
&trans  &trans        &trans        &trans            &trans          &trans  &trans    &trans  &trans  &trans           &trans             &trans         &trans         &trans
                      &trans        &trans            &trans          &trans  &trans    &trans  &trans  &trans           &trans             &trans
            >;
        };
    };
};
