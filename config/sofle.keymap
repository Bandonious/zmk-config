#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        mt_HRM: mt_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <260>;
            flavor = "tap-preferred";
        };

        CapWL: CapWL {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPWL";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DEL>;
            key-positions = <53 56>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BRANDX";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC       &kp N1              &kp N2    &kp N3              &kp N4                  &kp N5                                                      &kp N6                     &kp N7                   &kp N8               &kp N9    &kp N0               &none
&kp GRAVE     &kp Q               &kp W     &kp F               &kp P                   &kp B                                                       &kp J                      &kp L                    &kp U                &kp Y     &kp SEMICOLON        &none
&none         &mt_HRM LEFT_WIN A  &kp R     &mt_HRM LEFT_ALT S  &mt_HRM LEFT_CONTROL T  &kp G                                                       &kp M                      &mt_HRM RIGHT_CONTROL N  &mt_HRM RIGHT_ALT E  &kp I     &mt_HRM RIGHT_WIN O  &kp SQT
&kp LEFT_ALT  &kp Z               &kp X     &kp C               &kp D                   &kp V                     &kp LEFT_ALT    &kp K_PLAY_PAUSE  &kp K                      &kp H                    &kp COMMA            &kp DOT   &kp FSLH             &kp EXCLAMATION
                                  &kp LGUI  &kp LALT            &kp LCTRL               &mt_HRM LEFT_SHIFT SPACE  &lt 1 TAB       &lt 2 ENTER       &mt RIGHT_SHIFT BACKSPACE  &mt RIGHT_CONTROL DEL    &kp RALT             &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp LS(TAB) TAB>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NAVNUM";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans                &kp F1                 &kp F2              &kp F3          &kp F4               &kp F5                                  &kp F6        &kp F7           &kp F8           &kp F9           &kp F10      &kp F11
&kp BACKSLASH         &kp CARET              &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT_ARROW)  &kp AMPERSAND                           &kp PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp HASH     &kp F12
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp UNDERSCORE                          &kp MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PERCENT  &none
&kp K_UNDO            &kp K_REDO             &kp K_PASTE         &kp K_COPY      &kp LEFT_BRACKET     &kp RIGHT_BRACKET  &trans    &trans     &kp ASTERISK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOLLAR   &kp KP_NUMLOCK
                                             &trans              &trans          &trans               &trans             &trans    &kp EQUAL  &trans        &kp SLASH        &kp KP_NUMBER_0  &kp KP_DOT
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_UP PAGE_DOWN>,
                <&inc_dec_kp K_NEXT K_PREVIOUS>;
        };

        raise_layer {
            display-name = "ACTION";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp C_SLEEP  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans      &trans    &trans    &trans     &trans   &trans
&none        &kp INS       &kp PSCRN     &none         &none         &trans                          &kp PG_UP   &trans    &kp UP    &trans     &kp N0   &trans
&CapWL       &none         &none         &none         &trans        &none                           &kp PG_DN   &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans       &none         &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &kp K_CALC  &trans    &trans    &trans     &trans   &trans
                           &trans        &trans        &trans        &trans        &trans    &trans  &trans      &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none              &none  &none  &none  &none  &none
            >;
        };
    };
};
